# Copy to .env and load it before starting the server (e.g. `set -a; source .env; set +a`).
# .env holds real keys and tokens: it is git-ignored, so never commit it. Share values privately.

# Claude feedback backend
ANTHROPIC_API_KEY=
# PITCH_CLAUDE_MODEL=claude-opus-5-5

# Default feedback model when the request doesn't name one: claude | gemma4-ft | gemma4-base | rules
PITCH_DEFAULT_BACKEND=claude

# Ollama (Gemma 4)
# OLLAMA_URL=http://localhost:11434
# Ollama on another PC through its voice server: OLLAMA_URL=https://<voice-server>/v1/ollama and its VOICE_SERVER_TOKEN
# OLLAMA_TOKEN=
# PITCH_OLLAMA_MODEL_FT=pitchcoach-gemma4
# PITCH_OLLAMA_MODEL_BASE=gemma4:e4b
# How long Ollama keeps the model loaded: -1 = always (first request after start loads it), or e.g. 10m
# PITCH_OLLAMA_KEEP_ALIVE=-1
# PITCH_OLLAMA_NUM_CTX_MAX=24576   # largest Gemma context window (tokens); sized per request up to this

# Speech to text: duudlaga (https://api.duudlaga.dev) | whisper (BuzzASR, needs requirements-ml.txt)
#   | remote (voice server on a GPU PC, see voice/README.md) | stub
PITCH_ASR=duudlaga
# Developer key from https://duudlaga.dev/developers/console/keys (dk_live_…)
DUUDLAGA_API_KEY=
# DUUDLAGA_BASE_URL=https://api.duudlaga.dev
# DUUDLAGA_LANGUAGES=mn-MN,en-US
# Voice server for PITCH_ASR=remote: the URL scripts/voice.ps1 prints, and its VOICE_SERVER_TOKEN
# PITCH_VOICE_URL=http://localhost:8001
# PITCH_VOICE_TOKEN=
# The voice server's own token (scripts/voice.ps1 keeps it in .env.voice); clients send it as PITCH_VOICE_TOKEN
# VOICE_SERVER_TOKEN=
# PITCH_VOICE_TIMEOUT_S=300
# When the voice server can't be used, Duudlaga transcribes instead (needs DUUDLAGA_API_KEY); none = fail
# PITCH_ASR_FALLBACK=duudlaga
# When Gemma can't be reached: auto (Claude if ANTHROPIC_API_KEY is set, else the no-model check) | claude | rules | none
# PITCH_FEEDBACK_FALLBACK=auto
# Slide matching: e5 (needs sentence-transformers) | none (key words only)
PITCH_EMBEDDINGS=e5

# Fine-tuned filler classifier (training/fillers): unset = off, a model folder = run here,
# remote = the voice server's /v1/fillers (set FILLER_MODEL_PATH on the voice PC)
# PITCH_FILLER_MODEL=

# Front-end origins allowed by CORS (comma-separated)
PITCH_CORS_ORIGINS=http://localhost:3000
# The deployed site and its backend, for the admin Status tab's "Deployed site" view (defaults shown)
# PITCH_DEPLOYED_SITE_URL=https://saylo-rose.vercel.app
# PITCH_DEPLOYED_API_URL=https://saylo-backend-el5e.onrender.com
# The GPU PC's voice server through the Tailscale tunnel; empty turns those Status cards off
# PITCH_TUNNEL_URL=https://ddd5.tail9b3d3b.ts.net/voice
# Google sign-in (POST /auth/google) checks Supabase Auth tokens. Same project as the web app's
# NEXT_PUBLIC_SUPABASE_*; leave unset to turn it off.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Database: SQLite by default. For Supabase, use the session pooler URI from
# Project Settings > Database > Connection string (port 5432), with your password:
# PITCH_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# PITCH_DATA_DIR=./data
# PITCH_RETENTION_DAYS=0   # 0 = keep projects until the user deletes them

# Coach voice (text to speech). PITCH_TTS: auto (ElevenLabs when its key is set, else Azure)
# | azure | elevenlabs (eleven_v4_turbo reads Mongolian). Azure's free F0 tier: 500k chars/month.
# PITCH_TTS=auto
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# PITCH_TTS_VOICE=mn-MN-YesuiNeural
# ELEVENLABS_API_KEY=
# PITCH_ELEVENLABS_MODEL=eleven_v4_turbo   # or eleven_v4 (slower), eleven_v3
# PITCH_TTS_PAID_DAILY_CHARS=20000          # daily cap on characters read aloud; 0 = no limit

# Subscription: a free trial, then paid periods through QPay. Nobody is blocked until
# PITCH_BILLING_ENFORCED=true, so leave it off for local development.
# PITCH_BILLING_ENFORCED=false
# PITCH_TRIAL_DAYS=7
# PITCH_SUBSCRIPTION_DAYS=30
# PITCH_SUBSCRIPTION_PRICE_MNT=            # price of one period in tögrög; unset turns payments off
# QPAY_BASE_URL=https://merchant-sandbox.qpay.mn   # production: https://merchant.qpay.mn
# QPAY_CLIENT_ID=
# QPAY_CLIENT_SECRET=
# QPAY_INVOICE_CODE=
# PITCH_PUBLIC_API_URL=                    # public address of this API, for QPay's payment callback

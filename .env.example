# Copy to .env and load it before starting the server (e.g. `set -a; source .env; set +a`).

# Claude feedback backend
ANTHROPIC_API_KEY=
# PITCH_CLAUDE_MODEL=claude-opus-5-5

# Default feedback model when the request doesn't name one: claude | gemma4-ft | gemma4-base | rules
PITCH_DEFAULT_BACKEND=claude

# Ollama (Gemma 4)
# OLLAMA_URL=http://localhost:11434
# Ollama on another PC through its voice server: OLLAMA_URL=https://<voice-server>/v1/ollama and its VOICE_SERVER_TOKEN
# OLLAMA_TOKEN=
# PITCH_OLLAMA_MODEL_FT=pitchcoach-gemma4
# PITCH_OLLAMA_MODEL_BASE=gemma4:e4b
# How long Ollama keeps the model loaded: -1 = always (first request after start loads it), or e.g. 10m
# PITCH_OLLAMA_KEEP_ALIVE=-1

# Speech to text: duudlaga (https://api.duudlaga.dev) | whisper (BuzzASR, needs requirements-ml.txt)
#   | remote (voice server on a GPU PC, see voice/README.md) | stub
PITCH_ASR=duudlaga
# Developer key from https://duudlaga.dev/developers/console/keys (dk_live_…)
DUUDLAGA_API_KEY=
# DUUDLAGA_BASE_URL=https://api.duudlaga.dev
# DUUDLAGA_LANGUAGES=mn-MN,en-US
# Voice server for PITCH_ASR=remote: the URL scripts/voice.ps1 prints, and its VOICE_SERVER_TOKEN
# PITCH_VOICE_URL=http://localhost:8001
# PITCH_VOICE_TOKEN=
# PITCH_VOICE_TIMEOUT_S=300
# Slide matching: e5 (needs sentence-transformers) | none (key words only)
PITCH_EMBEDDINGS=e5

# Front-end origins allowed by CORS (comma-separated)
PITCH_CORS_ORIGINS=http://localhost:3000
# Google sign-in (POST /auth/google) checks Supabase Auth tokens. Same project as the web app's
# NEXT_PUBLIC_SUPABASE_*; leave unset to turn it off.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Database: SQLite by default. For Supabase, use the session pooler URI from
# Project Settings > Database > Connection string (port 5432), with your password:
# PITCH_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# PITCH_DATA_DIR=./data
# PITCH_RETENTION_DAYS=0   # 0 = keep projects until the user deletes them

# Coach voice (text to speech). PITCH_TTS: auto (Azure when its keys are set, else the voice
# server's free MMS-TTS) | voice | azure | elevenlabs (paid; eleven_v4_turbo reads Mongolian).
# PITCH_TTS=auto
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# PITCH_TTS_VOICE=mn-MN-YesuiNeural
# ELEVENLABS_API_KEY=
# PITCH_ELEVENLABS_MODEL=eleven_v4_turbo   # or eleven_v4 (slower), eleven_v3
# PITCH_TTS_PAID_DAILY_CHARS=20000          # daily cap for Azure/ElevenLabs characters; 0 = no limit

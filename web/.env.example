# FastAPI server. Leave unset to run the UI against the built-in mock backend.
# The browser calls /api/v1 on this app and Next forwards it here (next.config.ts).
# The deployed site uses https://saylo-backend-el5e.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only. The folder desk "send to model" button. Claude needs a key; Ollama runs locally.
# ANTHROPIC_API_KEY=
# PITCH_CLAUDE_MODEL=claude-opus-5-5
# OLLAMA_URL=http://localhost:11434
# PITCH_OLLAMA_MODEL_BASE=gemma4:e4b
# Gemma on the GPU PC from a deployed site: OLLAMA_URL=https://<voice-server>/v1/ollama, OLLAMA_TOKEN=<VOICE_SERVER_TOKEN>
# OLLAMA_TOKEN=
# Keep the model loaded: -1 = always, or e.g. 10m. The page also pre-loads it when it opens.
# PITCH_OLLAMA_KEEP_ALIVE=-1

# Server-only. Local voice server (voice/README.md) used by the record button.
# Defaults: http://127.0.0.1:8001 and the token in the repo's .env.voice.
# PITCH_VOICE_URL=
# PITCH_VOICE_TOKEN=

# Server-only. LibreOffice converts PowerPoint (.pptx/.ppt) and .odp slides to PDF for the folder page.
# Found automatically in the usual install places (B:\LibreOffice, Program Files, /usr/bin); otherwise set:
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Browser. "Continue with Google" through Supabase Auth; leave unset to hide the button.
# Use the publishable key only, never the secret key. The backend needs the same URL and key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

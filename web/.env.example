# FastAPI server. Leave unset to run the UI against the built-in mock backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only. The folder desk prototype button sends saved speech, audio, and the slide here.
# ANTHROPIC_API_KEY=
# PITCH_CLAUDE_MODEL=claude-opus-5-5

# Server-only. Local voice server (voice/README.md) used by the record button.
# Defaults: http://127.0.0.1:8001 and the token in the repo's .env.voice.
# PITCH_VOICE_URL=
# PITCH_VOICE_TOKEN=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

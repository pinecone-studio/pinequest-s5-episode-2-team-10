# Copy to backend/.env.local (do not overwrite an existing local env file).
# Existing process environment values take precedence. backend/.env and the
# repository-root .env are loaded as fallbacks.

# Supabase PostgreSQL connection string:
# Supabase Dashboard > Project Settings > Database > Connection string > Session pooler
# Uncomment and replace with your actual URI. Do not use the Supabase API secret key here.
# PITCH_DB_URL='postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres'

# Supabase Storage (create a private bucket named saylo-session-files first).
# This key is server-only; never use it in the web app or commit a real value.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_STORAGE_BUCKET=saylo-session-files
# SUPABASE_SERVICE_ROLE_KEY=<server-side-service-role-key>

# Comma-separated Google account emails that receive the initial admin role.
# PITCH_ADMIN_EMAILS=admin@example.com,another-admin@example.com

# Use Gemma through Ollama running on this laptop.
PITCH_DEFAULT_BACKEND=gemma4-base
OLLAMA_URL=http://localhost:11434
PITCH_OLLAMA_MODEL_BASE=gemma4:e4b
# PITCH_ASR=stub
# PITCH_EMBEDDINGS=none